{
  "name": "trevo-da-sorte",
  "private": true,
  "version": "0.24.12.1",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "lint": "tsc --noEmit",
    "build": "tsc -b && vite build && node -e \"const fs=require('fs'); if(fs.existsSync('server.cjs')) fs.copyFileSync('server.cjs', 'dist/server.cjs');\"",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "frontend": "vite",
    "igw:test": "node scripts/test-igamewin.mjs",
    "parser:test": "node scripts/test-parser.mjs",
    "admin:check": "node scripts/check-admin.mjs",
    "deploy:check": "npm run admin:check && npm run build",
    "firebase:rules": "npx firebase-tools deploy --only firestore:rules --project ai-studio-applet-webapp-6ac28",
    "firebase:design-rules": "npx firebase-tools deploy --only firestore:rules,storage --project ai-studio-applet-webapp-6ac28",
    "start": "node server.ts",
    "start:pm2": "pm2 start ecosystem.config.cjs --env production",
    "restart:pm2": "pm2 restart amora-bet-api --update-env",
    "logs:pm2": "pm2 logs amora-bet-api",
    "prod:audit": "node scripts/production-audit.mjs",
    "smoke": "node scripts/smoke-vps.mjs",
    "predeploy:vps": "npm run prod:audit && npm run build",
    "db:seed": "node scripts/seed-database.mjs",
    "db:reset": "node scripts/reset-database.mjs",
    "db:audit": "node scripts/audit-database.mjs",
    "firebase:project-check": "node scripts/check-firebase-project.mjs",
    "firebase:bootstrap": "node scripts/bootstrap-new-firebase.mjs",
    "cloudrun:check": "node scripts/cloudrun-check.mjs"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@supabase/supabase-js": "^2.117.3",
    "@whiskeysockets/baileys": "^6.7.24",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
